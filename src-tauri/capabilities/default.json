{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and plan viewer windows",
  "windows": ["main", "plan-viewer-*"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "dialog:allow-save",
    "opener:allow-open-path",
    "opener:allow-reveal-item-in-dir"
  ]
}
