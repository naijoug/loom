{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Loom",
  "version": "0.1.0",
  "identifier": "com.naijoug.loom",
  "build": {
    "beforeDevCommand": "pnpm dev --host 127.0.0.1 --port 1420 --strictPort",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Loom",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
