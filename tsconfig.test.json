{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "declaration": false,
    "emitDeclarationOnly": false,
    "isolatedModules": false,
    "module": "CommonJS",
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": ".tmp/test-build",
    "rootDir": "."
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "references": [],
  "exclude": [
    "src/workbench",
    "src/api/workbenchClient.ts",
    "src/main.tsx"
  ]
}
