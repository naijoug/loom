{
  "schemaVersion": 1,
  "evidenceKind": "static-source-inventory",
  "upstream": {
    "repository": "https://github.com/craft-ai-agents/craft-agents-oss",
    "sha": "73bd9c2a3573158bea880984eb8d5fdb41e0cac2",
    "version": "0.14.0"
  },
  "scope": "Runtime behavior, screenshots, credentials and cross-platform parity require separate acceptance evidence.",
  "features": [
    {
      "id": "F01",
      "scope": "首次启动、连接选择、登录/重认证、引导",
      "locations": "`renderer/components/onboarding/`",
      "acceptance": "M2–3：空配置启动→连接测试→Workspace→首次会话；取消/失败可恢复。"
    },
    {
      "id": "F02",
      "scope": "Workspace 与 Project 管理，本地/远程切换、默认值",
      "locations": "`shared/workspaces/`、`shared/projects/`",
      "acceptance": "M1/M3/M7：可无 Project 聊天；切换不串配置、草稿和资源。"
    },
    {
      "id": "F03",
      "scope": "多列 Shell、导航历史、窗口/分栏、搜索与命令入口",
      "locations": "`renderer/components/app-shell/`、`contexts/NavigationContext.tsx`",
      "acceptance": "M3：分栏尺寸、前进后退、多窗口、空态、持久化与快捷键。"
    },
    {
      "id": "F04",
      "scope": "Inbox、会话状态、归档、旗标、标签/值、筛选、未读",
      "locations": "`SessionList.tsx`、`shared/statuses/`、`shared/labels/`",
      "acceptance": "M3：多窗口状态一致；后台结束出现未读；重启与过滤结果一致。"
    },
    {
      "id": "F05",
      "scope": "Composer、草稿、附件、来源/技能引用、模型/thinking",
      "locations": "`input/FreeFormInput.tsx`",
      "acceptance": "M3–4：拖放/粘贴/引用真实生效；IME、发送键、模式循环按参考测试。"
    },
    {
      "id": "F06",
      "scope": "流式文本/thinking/tool、停止、排队/steering、重试",
      "locations": "`server/sessions/SessionManager.ts`、`shared/agent/backend/types.ts`",
      "acceptance": "M2–3：三轮追问、工具卡片、生成中输入、停止后再发、会话切换。"
    },
    {
      "id": "F07",
      "scope": "历史、搜索、分支/压缩、笔记、导入导出、跨工作区转移",
      "locations": "`shared/sessions/`、`server/handlers/rpc/{sessions,transfer}.ts`",
      "acceptance": "M1/M3/M7：长历史冷启动、断线补流、分支隔离、导入幂等、损坏记录可诊断。"
    },
    {
      "id": "F08",
      "scope": "多 LLM connections、模型能力与账户、API/OAuth/自定义端点",
      "locations": "`shared/config/llm-connections.ts`、`agent/backend/`、`shared/auth/`",
      "acceptance": "M2/M7：Claude 与 Pi 家族均通过；每种基线认证/端点能力独立核验。"
    },
    {
      "id": "F09",
      "scope": "Explore/Ask/Execute、可选 Guarded、分层权限、记忆审批",
      "locations": "`shared/agent/{mode-types,mode-manager,permissions-config}.ts`",
      "acceptance": "M0/M2/M6：真实工具执行前允许/拒绝；过期/跨回合响应不能放行。"
    },
    {
      "id": "F10",
      "scope": "Sources：MCP stdio/HTTP/SSE、REST、本地文件、OAuth/续期",
      "locations": "`shared/sources/`、`server/handlers/rpc/sources.ts`",
      "acceptance": "M4：三种传输、凭据过期恢复、Source 级权限、启停与热更新。"
    },
    {
      "id": "F11",
      "scope": "Skills：多层发现、导入/创建、详情、requiredSources、显式调用",
      "locations": "`shared/skills/`、`renderer/pages/SkillInfoPage.tsx`",
      "acceptance": "M4：只配置必需上下文；同名覆盖按参考优先级；引用激活依赖 Source。"
    },
    {
      "id": "F12",
      "scope": "内置 session 工具、Agent 修改配置、认证/计划交互",
      "locations": "`packages/session-tools-core/src/tool-defs.ts`",
      "acceptance": "M2/M4–6：catalog 逐项映射；UI 和工具变更共用校验与持久化。"
    },
    {
      "id": "F13",
      "scope": "富内容与查看器：Markdown/代码/Mermaid/表格/图像/PDF/Office/HTML/diff",
      "locations": "`packages/ui/src/components/overlay/`、`apps/electron/resources/`",
      "acceptance": "M5：转换、缩放、复制、定位、差异展示；加载失败和不可信 HTML 隔离。"
    },
    {
      "id": "F14",
      "scope": "内置 Browser：窗口/标签、导航、登录态、AX/CDP、下载/网络",
      "locations": "`apps/electron/src/main/browser-pane-manager.ts`、`browser-cdp.ts`",
      "acceptance": "M0/M5：相同窗口操作、后台保留、切 Workspace 隔离、真实页面点击/填表。"
    },
    {
      "id": "F15",
      "scope": "Pages：创建/编辑、静态/交互/live、数据、定时刷新、授权",
      "locations": "`shared/pages/`、`server/pages/`、`renderer/components/pages/`",
      "acceptance": "M5–6：数据更新可见；内容变化使旧授权失效；刷新失败有记录。"
    },
    {
      "id": "F16",
      "scope": "后台任务、子会话、消息、父子关系、进度和输出",
      "locations": "`server/sessions/`、`shared/agent/spawn-session-tool.ts`",
      "acceptance": "M6：创建/结束/失败/孤儿恢复；父子权限不提升，跨会话消息精确送达。"
    },
    {
      "id": "F17",
      "scope": "Task 看板、task.yaml DAG、并发/依赖、暂停恢复、验证/修复",
      "locations": "`server/tasks/TaskRunner.ts`、`shared/tasks/`、`app-shell/kanban/`",
      "acceptance": "M6：有依赖的 DAG、失败节点重试、停止/重启；不执行上游仅预留节点。"
    },
    {
      "id": "F18",
      "scope": "Automations：时间/事件、prompt/script/webhook、历史/重试",
      "locations": "`shared/automations/`",
      "acceptance": "M6：时区/重复事件/超时/重启测试；触发来源与执行证据可追溯。"
    },
    {
      "id": "F19",
      "scope": "可选 Decision layer 与相关 AI 设置",
      "locations": "`shared/decisions/`、`server/decisions/`",
      "acceptance": "M6：开/关、不可用、低置信度回退；每项功能核对，不允许模型提升权限。"
    },
    {
      "id": "F20",
      "scope": "Remote/headless、Web UI、CLI、混合工作区和本地能力桥",
      "locations": "`packages/server/`、`server/transport/`、`apps/{webui,cli}/`",
      "acceptance": "M7：认证、断线重连、跨客户端事件、远程请求本机浏览器、能力缺失。"
    },
    {
      "id": "F21",
      "scope": "Messaging：Telegram/WhatsApp/Lark、pairing、绑定/准入/回传",
      "locations": "`packages/messaging-gateway/`、`messaging-whatsapp-worker/`",
      "acceptance": "M7：专用测试账户往返；未授权发送者被拒；去重/解绑/重启可靠。"
    },
    {
      "id": "F22",
      "scope": "会话/Page 分享、更新/撤销、Viewer、密码保护",
      "locations": "`server/sessions/SessionManager.ts`、`shared/pages/publisher.ts`、`apps/viewer/`",
      "acceptance": "M7：自己的服务端点上创建/读取/更新/撤销，离线导出不能替代。"
    },
    {
      "id": "F23",
      "scope": "所有设置域、主题/语言、快捷键、通知、深链、更新与打包",
      "locations": "`renderer/pages/settings/`、`apps/electron/src/main/`",
      "acceptance": "M3/M8：逐页功能矩阵；真实持久化、系统集成及三平台产物。"
    }
  ],
